        <div id="usertermsandconditions" class="iac-dismissable" role="alert" aria-live="assertive">
            <div class="iac-window iac-modal w-800px h-600px">
                        <div class="window-header">
            <h2 class="text-darkblue">Terms & Conditions</h2>
        </div>
        <div class="window-content border">
                <span>
                    <p>By clicking "Accept," you confirm that you are an Investia or iA Private Wealth Advisor and that you have read the terms detailed below. This site is not intended for and must not be accessed by or shared with any person who is not an Investia or iA Private Wealth Advisor.</p><p>This site is operated by IA Clarington Investments Inc (&ldquo;iA Clarington&rdquo;) and is for information purposes only. It does not constitute an offer to sell or a solicitation of an offer to buy any security or investment or advisory service, or a recommendation of any such security or service, that may be referenced on or through this site. No representation is given that the securities, products, or services discussed on, or accessible through, this website are suitable for any particular investor. You acknowledge that the provision of any information through this site shall not constitute or be considered investment advice. This site should not be considered as communicating any invitation or inducement to engage in investment activity in any jurisdiction.</p><p>In accessing and using this site you acknowledge that you have read, understood, and agree to accept and be bound by the terms and conditions set out herein, which may be modified by us from time to time without notice, by posting changes within the site. If you do not accept any of the terms, please discontinue use of this site and any of its associated pages.</p>
                </span>

        </div>
        <div class="window-footer align-self-end">
            <button autofocus type="button" class="modal-close iac-dismiss iac-elite-btn btn-input w-75px" style="box-sizing: content-box;">Accept</button>
        </div>

                <input id="usertermsandconditions_blp" type="hidden" value="[&quot;/advisor-hub/user/account-notification&quot;,&quot;/fr/carrefour-des-conseilles/user/notification-de-compte&quot;,&quot;/auth/registered&quot;,&quot;/advisor-hub/user/profile_advisor&quot;,&quot;/fr/carrefour-des-conseilles/user/profil_conseiller&quot;,&quot;/advisor-hub/user/profile_advisor/profile_advisor_edit&quot;,&quot;/fr/carrefour-des-conseilles/user/profil_conseiller/profil_conseiller_edit&quot;]"/>
            </div>
        </div>
        <script type="module" async>
            const blacklistedPagesForBypassingPopup = JSON.parse($("#usertermsandconditions_blp").val() ?? []);

            import 'https://kendo.cdn.telerik.com/2022.3.1109/js/jszip.min.js';import 'https://kendo.cdn.telerik.com/2022.3.1109/mjs/kendo.window.js';
import '/kendo-ui-license.js';

            import "/iaclarington/IACCommon/Resources/Scripts/iac.ES6.api.js?v=6448";

            $(document).ready(() => {
                // DEVNOTE: Checking this on client ensures we don't execute unnecessary /GetTerms on every page load.
                //          If this cookie exists, this means they have already seen the popup and it should have already
                //          been synced to their profile.
                const modalId = "usertermsandconditions";
                const popupCookie = Cookies.get(modalId);
                const userAlreadyAcceptedTerms = popupCookie == "true";
                const pageBypassesPopup = blacklistedPagesForBypassingPopup.find(x => x == location.pathname);
                if (userAlreadyAcceptedTerms || pageBypassesPopup) return;

                iac.service.execute("GET", `/iac/terms?executionMode=AffiliateAdvisorsOnly&cookieId=usertermsandconditions`).then(resp => {
                    const popupIsRequired = resp.CustomResponse == 1;
                    if (popupIsRequired) {
                        // DEVNOTE: iac-dismissable already handles the showing/hiding of the wrapper container on page load - but
                        //          it doesn't handle the body overlay or the scrollbar. Therefore, we still need to call openModal().
                        iac.utility.openModal(modalId);

                        // DEVNOTE: iac-dismissable already handles the cookie-setting. This is only for profile persistence.
                        const syncWithProfile = "True" == "True";
                        if (syncWithProfile) {
                            $(`#${modalId} .modal-close`).on("click", (e) => {
                                iac.service.execute("POST", `/iac/terms`, { TermsAccepted: true, CookieId: modalId, SyncWithProfile: syncWithProfile });
                            });
                        }
                    }
                    else {
                        $(`#${modalId}`).remove();
                    }
                });
            });
        </script>



